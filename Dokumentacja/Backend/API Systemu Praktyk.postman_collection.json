{
  "info": {
    "name": "API Systemu Praktyk",
    "description": "Pełna kolekcja REST API systemu rozliczania praktyk zawodowych (ANS Elbląg). Wszystkie endpointy wymagają zalogowanej sesji (ciasteczko Flask-Login). Ustaw zmienną baseUrl oraz, w razie potrzeby, id zasobów.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "internshipId", "value": "1" },
    { "key": "studentId", "value": "1" }
  ],
  "item": [
    {
      "name": "Studenci",
      "item": [
        {
          "name": "Lista studentów",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] }
          }
        },
        {
          "name": "Szczegóły studenta",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] }
          }
        },
        {
          "name": "Utwórz studenta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"imie\": \"Adam\",\n  \"nazwisko\": \"Nowak\",\n  \"numer_indeksu\": \"987654\",\n  \"email\": \"adam@uczelnia.pl\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] }
          }
        },
        {
          "name": "Aktualizuj studenta",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"imie\": \"Adam\",\n  \"nazwisko\": \"Kowalczyk\",\n  \"email\": \"adam.k@uczelnia.pl\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] }
          }
        },
        {
          "name": "Usuń studenta",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] }
          }
        }
      ]
    },

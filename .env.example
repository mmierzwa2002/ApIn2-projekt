# ── Baza danych ──────────────────────────────────────────────────────────────
# Format: postgresql://użytkownik:hasło@host:port/nazwa_bazy
# Domyślne dla lokalnego PostgreSQL (bez .env): sqlite:///praktyki.db
DATABASE_URL=postgresql://postgres:haslo@localhost:5432/praktyki

# ── Klucz sesji Flask ─────────────────────────────────────────────────────────
# Dowolny długi losowy ciąg; chroni podpis ciasteczka sesji.
# Wygeneruj np.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=wstaw-tutaj-losowy-ciag-znakow

# ── Logowanie przez Microsoft (Azure AD / konto uczelni) ─────────────────────
# Dane aplikacji z portalu https://portal.azure.com → Azure Active Directory →
# Rejestracje aplikacji.  Jeśli nie używasz OAuth, zmienne można pominąć —
# logowanie lokalne (e-mail + hasło) działa bez nich.
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=wstaw-sekret-aplikacji-azure
MICROSOFT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MICROSOFT_REDIRECT_URI nie jest wymagany — aplikacja wylicza URI dynamicznie.

# ── Logowanie przez Google ────────────────────────────────────────────────────
# Dane aplikacji z konsoli https://console.cloud.google.com → API i usługi →
# Dane uwierzytelniające → Identyfikatory klienta OAuth 2.0.
# Jeśli nie używasz logowania przez Google, zmienne można pominąć.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
